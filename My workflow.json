    {
      "parameters": {
        "jsCode": "const buffer = await this.helpers.getBinaryDataBuffer(0, 'book');\nconst text = buffer.toString('utf-8');\nconst pages = JSON.parse(text);\n// unit1-3.json zaten sadece sayfa 1-80 içeriyor, bu yüzden aralığı tüm dosyayı kapsayacak şekilde açıyoruz\nconst START_PAGE = 1;\nconst END_PAGE = 999;\nconst out = [];\nfor (const p of pages) {\n  const clean = String((p && p.text) || '').replace(/\\s+/g, ' ').trim();\n  // skip empty/near-empty pages: Gemini returns empty vectors for them\n  if (clean.length >= 30 && Number(p.page) >= START_PAGE && Number(p.page) <= END_PAGE) out.push({ json: { page: p.page, text: clean } });\n}\nif (out.length === 0) {\n  throw new Error('No page with usable text found in the JSON file.');\n}\nreturn out;"
      },
